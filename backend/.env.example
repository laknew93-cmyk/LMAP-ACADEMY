# Local development. Production values are set in the Render dashboard.
DATABASE_URL=sqlite:///./lmap.db
SECRET_KEY=change-this-to-a-long-random-string-in-production
CORS_ORIGINS=*

# Razorpay (Dashboard → Account & Settings → API Keys). Leave empty locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (Dashboard → Webhooks, events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Local only: lets checkout succeed without Razorpay. NEVER set this in production.
ALLOW_DEV_PAYMENTS=true

# Admin account is created on first start only if ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@lmapacademy.org
ADMIN_PASSWORD=

BUNDLE_PRICE=6999
UPLOAD_DIR=uploads
