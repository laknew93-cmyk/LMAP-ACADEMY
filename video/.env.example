# HeyGen (app.heygen.com → Settings → API, or platform.heygen.com/api-keys)
HEYGEN_API_KEY=
# From `python3 video/pipeline.py avatars` and `python3 video/pipeline.py voices english`
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Optional: avatar_iv (default), avatar_v or avatar_iii
HEYGEN_ENGINE=
HEYGEN_RESOLUTION=1080p
HEYGEN_VOICE_SPEED=1.0
# Optional solid background, e.g. #F5F3FF
HEYGEN_BACKGROUND_COLOR=
# How many videos render at the same time
HEYGEN_PARALLEL=3

# Site upload — must match VIDEO_UPLOAD_TOKEN on the LMAP-ACADEMY Render service
SITE_API=https://lmap-academy.onrender.com
VIDEO_UPLOAD_TOKEN=
